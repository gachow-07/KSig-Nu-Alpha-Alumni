# Copy this file to .env.local and fill in the values from Supabase:
# Dashboard → Project Settings → API Keys (and Data API for the URL).
# NEVER commit .env.local or put the secret key anywhere in the browser code.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Secret key (starts with sb_secret_...). The legacy "service_role" key also works.
SUPABASE_SECRET_KEY=

# Optional: the public URL of the site, used for link previews.
# Leave blank on Vercel; it's detected automatically.
NEXT_PUBLIC_SITE_URL=
