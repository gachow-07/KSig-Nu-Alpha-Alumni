# Copy this file to .env.local to test the sign-up form on your computer.
# Values come from Supabase: Dashboard → Project Settings → API Keys
# (and Data API, or the "Connect" button, for the URL).
#
# Both values are safe to be public: the publishable key can only call the
# locked-down sign-up function. NEVER put the *secret* key (sb_secret_...) here.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
